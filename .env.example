# ============ قاعدة البيانات ============
# Neon PostgreSQL - Pooler (للتطبيق)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon PostgreSQL - Direct (للـ migrations)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ============ الأمان ============
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"

# ============ البيئة ============
NODE_ENV="development"

# ============ التخزين ============
STORAGE_PATH="./storage"
BLOB_READ_WRITE_TOKEN=""

# ============ Seed Credentials (DEV ONLY) ============
# تُستخدم فقط عند تشغيل prisma db seed في بيئة التطوير
# لا تستخدمها في الإنتاج. غيّر كلمات السر بعد أول تسليم.
SEED_ADMIN_PASSWORD="Admin@123456"
SEED_TEST_PASSWORD="Test@123456"

# ============ Resend Email ============
# احصل على مفتاح مجاني من https://resend.com/api-keys
# في التطوير: استخدم onboarding@resend.dev
# في الإنتاج: استخدم بريد مخصص بعد ربط الدومين
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
